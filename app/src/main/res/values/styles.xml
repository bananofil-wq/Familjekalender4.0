<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Familjekalender" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#0B0A0F</item>
        <item name="android:colorAccent">#B47CFF</item>
        <item name="android:statusBarColor">#0B0A0F</item>
        <item name="android:navigationBarColor">#0B0A0F</item>
        <item name="android:navigationBarDividerColor">#0B0A0F</item>
    </style>

    <!-- Dialog-like, floating activity so the launcher remains visible under quick-add. -->
    <style name="Theme.Familjekalender.WidgetQuickAdd" parent="Theme.Familjekalender">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowDimAmount">0.4</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="WidgetEventText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">#FFF8F5FA</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="WidgetEventRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@drawable/widget_event_row_bg</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="WidgetEventWho">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="WidgetEventActivity">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:textColor">#F7FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="WidgetEventTime">
        <item name="android:layout_width">92dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">#D8FFFFFF</item>
        <item name="android:textSize">10sp</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="WidgetWeekReminderText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">18dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">#FFF3EBDE</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
