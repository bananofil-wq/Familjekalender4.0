<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:layout_marginTop="3dp"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/widget_event_row_bg">

    <TextView
        android:id="@+id/widget_item_who"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="2" />

    <TextView
        android:id="@+id/widget_item_activity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="5dp"
        android:textColor="#F7FFFFFF"
        android:textSize="12sp"
        android:maxLines="2" />

    <TextView
        android:id="@+id/widget_item_time"
        android:layout_width="92dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="#D8FFFFFF"
        android:textSize="10sp"
        android:maxLines="1" />

</LinearLayout>
