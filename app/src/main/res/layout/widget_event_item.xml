<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="43dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="2dp"
    android:paddingLeft="9dp"
    android:paddingRight="7dp"
    android:paddingTop="4dp"
    android:paddingBottom="5dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/widget_event_row_bg">

    <ImageView
        android:id="@+id/widget_item_accent"
        android:layout_width="4dp"
        android:layout_height="22dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/widget_accent_bar"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_item_who"
        android:layout_width="58dp"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:layout_width="1dp"
        android:layout_height="21dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="7dp"
        android:background="#5EADBAC6" />

    <ImageView
        android:id="@+id/widget_item_laundry_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="Tvätt"
        android:src="@drawable/ic_laundry_machine"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_item_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F7FFFFFF"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_item_live_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="#FF9CE5CF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_item_time"
        android:layout_width="86dp"
        android:layout_height="wrap_content"
        android:minHeight="27dp"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:gravity="center"
        android:textColor="#F4FFFFFF"
        android:textSize="10sp"
        android:background="@drawable/widget_time_pill"
        android:maxLines="1" />
</LinearLayout>