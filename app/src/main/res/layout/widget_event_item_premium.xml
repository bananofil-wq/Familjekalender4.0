<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/widget_event_row_bg">
    <ImageView
        android:id="@+id/widget_item_accent"
        android:layout_width="5dp"
        android:layout_height="31dp"
        android:layout_marginEnd="14dp"
        android:src="@drawable/widget_accent_bar"
        android:contentDescription="@null" />
    <TextView
        android:id="@+id/widget_item_who"
        android:layout_width="66dp"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
    <ImageView
        android:id="@+id/widget_item_laundry_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="Tvätt"
        android:src="@drawable/ic_laundry_machine"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_item_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_item_live_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="#FFD0D3D7"
            android:textSize="10sp"
            android:maxLines="1"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_item_time"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:gravity="end|center_vertical"
        android:textColor="#FFE2E2E5"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />
</LinearLayout>
