<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- Preserve the exact user-provided photography behind every live control. -->
    <ImageView
        android:id="@+id/widget_premium_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- The daily list takes the leftover space. The footer always keeps its
         measured height; it can never paint on top of activities. -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="15dp"
        android:paddingRight="16dp"
        android:paddingBottom="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="61dp"
                android:layout_height="70dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_badge_day"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:background="@drawable/widget_date_badge_top"
                    android:gravity="center"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_badge_number"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/widget_date_badge_bottom"
                    android:gravity="center"
                    android:textColor="#FF19191D"
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/widget_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#FFBCBDC0"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/widget_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFD58D"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_quick_add"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="46dp"
                android:layout_height="52dp"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFEF756E"
                android:textSize="30sp"
                android:textStyle="bold"
                android:contentDescription="Lägg till i familjekalendern" />
            <TextView
                android:id="@+id/widget_refresh"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="↻"
                android:contentDescription="Uppdatera" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_todo"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Öppna To-Do"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:background="@drawable/widget_action_green"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="12dp"
                android:layout_height="1dp"
                android:text="" />

            <TextView
                android:id="@+id/widget_shopping"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Öppna inköpslistan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:background="@drawable/widget_action_blue"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_section_separator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- A single scroll area for TODAY's event cards; never covers the footer. -->
        <ListView
            android:id="@+id/widget_event_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:scrollbars="vertical"
            android:fadingEdge="none"
            android:paddingBottom="4dp"
            android:clipToPadding="false" />

        <!-- At most three reminder rows are visible in this premium footer.
             Every additional item remains in the calendar or private inbox. -->
        <LinearLayout
            android:id="@+id/widget_week_reminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="10dp"
            android:paddingBottom="9dp"
            android:background="@drawable/widget_reminder_bg"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingBottom="4dp">
                <ImageView
                    android:id="@+id/widget_week_bell"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/widget_bell_icon"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/widget_week_reminders_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Veckans påminnelser"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/widget_week_reminders_week"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:background="@drawable/widget_reminder_week_badge"
                    android:text="V46"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>
            <TextView
                android:id="@+id/widget_week_reminder_empty"
                style="@style/WidgetWeekReminderText"
                android:textSize="13sp"
                android:text="Inga påminnelser denna vecka"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_week_reminder_1"
                style="@style/WidgetWeekReminderText"
                android:textSize="13sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_week_reminder_2"
                style="@style/WidgetWeekReminderText"
                android:textSize="13sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_week_reminder_3"
                style="@style/WidgetWeekReminderText"
                android:textSize="13sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/widget_week_reminder_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingLeft="14dp"
                android:paddingTop="2dp"
                android:paddingBottom="3dp"
                android:textColor="#FFFFB3A9"
                android:textSize="11sp"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Old view IDs must remain for RemoteViews compatibility, but cannot
             contribute height or overlap the three visible premium rows. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:id="@+id/widget_birthday_1" style="@style/WidgetWeekReminderText" />
            <TextView android:id="@+id/widget_birthday_2" style="@style/WidgetWeekReminderText" />
            <TextView android:id="@+id/widget_private_reminder_1" style="@style/WidgetWeekReminderText" />
            <TextView android:id="@+id/widget_private_reminder_2" style="@style/WidgetWeekReminderText" />
            <TextView android:id="@+id/widget_private_reminder_more" style="@style/WidgetWeekReminderText" />
            <TextView android:id="@+id/widget_persistent_reminder_1" style="@style/WidgetWeekReminderText" />
            <TextView android:id="@+id/widget_persistent_reminder_2" style="@style/WidgetWeekReminderText" />
            <TextView android:id="@+id/widget_persistent_reminder_more" style="@style/WidgetWeekReminderText" />
        </LinearLayout>

    <!--
        Compatibility tree for widgets that were already placed on the home screen
        before the scrollable ListView update. Android launchers can reapply the
        previously cached RemoteViews immediately after an APK upgrade. Keeping these
        old IDs prevents that reapply from failing with "Det gick inte att läsa in widgeten".
    -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout android:id="@+id/widget_event_1" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_event_1_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_event_1_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_event_1_time" style="@style/WidgetEventTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_event_2" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_event_2_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_event_2_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_event_2_time" style="@style/WidgetEventTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_event_3" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_event_3_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_event_3_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_event_3_time" style="@style/WidgetEventTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_event_4" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_event_4_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_event_4_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_event_4_time" style="@style/WidgetEventTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_event_5" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_event_5_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_event_5_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_event_5_time" style="@style/WidgetEventTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_event_6" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_event_6_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_event_6_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_event_6_time" style="@style/WidgetEventTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_event_7" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_event_7_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_event_7_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_event_7_time" style="@style/WidgetEventTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_event_8" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_event_8_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_event_8_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_event_8_time" style="@style/WidgetEventTime" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_tomorrow_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout android:id="@+id/widget_tomorrow_1" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_tomorrow_1_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_tomorrow_1_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_tomorrow_1_time" style="@style/WidgetEventTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_tomorrow_2" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_tomorrow_2_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_tomorrow_2_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_tomorrow_2_time" style="@style/WidgetEventTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_tomorrow_3" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_tomorrow_3_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_tomorrow_3_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_tomorrow_3_time" style="@style/WidgetEventTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_tomorrow_4" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_tomorrow_4_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_tomorrow_4_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_tomorrow_4_time" style="@style/WidgetEventTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_tomorrow_5" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_tomorrow_5_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_tomorrow_5_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_tomorrow_5_time" style="@style/WidgetEventTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_tomorrow_6" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_tomorrow_6_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_tomorrow_6_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_tomorrow_6_time" style="@style/WidgetEventTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_tomorrow_7" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_tomorrow_7_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_tomorrow_7_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_tomorrow_7_time" style="@style/WidgetEventTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_tomorrow_8" style="@style/WidgetEventRow">
            <TextView android:id="@+id/widget_tomorrow_8_who" style="@style/WidgetEventWho" />
            <TextView android:id="@+id/widget_tomorrow_8_activity" style="@style/WidgetEventActivity" />
            <TextView android:id="@+id/widget_tomorrow_8_time" style="@style/WidgetEventTime" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
