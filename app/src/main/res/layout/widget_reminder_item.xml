<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_reminder_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="43dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="3dp"
    android:paddingLeft="11dp"
    android:paddingRight="12dp"
    android:paddingTop="7dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/widget_reminder_bg">

    <ImageView
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/widget_bell_icon"
        android:contentDescription="Påminnelse"/>

    <TextView
        android:id="@+id/widget_reminder_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Påminnelse"
        android:textColor="#FFFFF3D9"
        android:textStyle="bold"
        android:textSize="11sp"
        android:maxLines="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:text="·"
        android:textSize="14sp"
        android:textColor="#FFD8BD8C"/>

    <TextView
        android:id="@+id/widget_reminder_activity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#FFF1ECE4"
        android:textSize="11sp"/>

    <TextView
        android:id="@+id/widget_reminder_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="#FFE3CB9E"
        android:textSize="10sp"
        android:maxLines="1"
        android:visibility="gone"/>
</LinearLayout>