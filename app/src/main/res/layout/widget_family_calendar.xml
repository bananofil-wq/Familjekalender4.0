<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#E617171C">

    <TextClock
        android:id="@+id/widget_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format24Hour="HH:mm"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF" />

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#FFBDB7C7"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/widget_today_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Idag"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#FFB47CFF" />

    <TextView
        android:id="@+id/widget_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#FFFFFFFF"
        android:maxLines="5"
        android:ellipsize="end"
        android:paddingBottom="7dp" />

    <TextView
        android:id="@+id/widget_tomorrow_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Imorgon"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#FFB47CFF" />

    <TextView
        android:id="@+id/widget_tomorrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#FFFFFFFF"
        android:maxLines="5"
        android:ellipsize="end" />
</LinearLayout>
