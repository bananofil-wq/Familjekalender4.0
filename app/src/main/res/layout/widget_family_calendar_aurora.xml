<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/widget_aurora_background">
    <!-- The artwork supplies the accurate frosted-glass materials, volumetric light,
         sun/cloud/rain and soft shadows. Live text/icons remain separate controls. -->
    <ImageView android:id="@+id/widget_aurora_art"
        android:layout_width="match_parent" android:layout_height="544dp"
        android:scaleType="fitXY" android:src="@drawable/widget_aurora_material"
        android:contentDescription="@null" android:clickable="false"
        android:focusable="false" android:importantForAccessibility="no"/>
    <!-- Selected in the EXISTING widget picker; no new appwidget provider. -->
    <TextView android:text="" android:layout_width="114dp" android:layout_height="30dp"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="13dp"
        android:background="@drawable/widget_aurora_island"/>
    <ImageView android:layout_width="66dp" android:layout_height="54dp"
        android:layout_gravity="right|top" android:layout_marginTop="27dp"
        android:layout_marginEnd="20dp" android:scaleType="fitCenter"
        android:src="@drawable/widget_aurora_moon" android:contentDescription="@null"
        android:clickable="false" android:focusable="false"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="180dp"
        android:layout_marginStart="45dp" android:layout_marginEnd="25dp"
        android:layout_marginTop="109dp" android:background="@android:color/transparent"
        android:elevation="0dp">
        <TextClock android:id="@+id/widget_aurora_date"
            android:layout_width="190dp" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:layout_marginTop="42dp"
            android:format12Hour="EEEE d MMM" android:format24Hour="EEEE d MMM"
            android:textAllCaps="true" android:textColor="#E4E3E5EF" android:textSize="16sp"
            android:fontFamily="sans" android:singleLine="true" />
        <TextClock android:id="@+id/widget_aurora_time"
            android:layout_width="190dp" android:layout_height="wrap_content"
            android:layout_marginStart="14dp" android:layout_marginTop="72dp"
            android:format12Hour="HH:mm" android:format24Hour="HH:mm"
            android:textColor="#FFFCF7FF" android:textSize="56sp"
            android:fontFamily="sans-serif-light" android:includeFontPadding="false"
            android:singleLine="true" />
        <FrameLayout android:layout_width="122dp" android:layout_height="102dp"
            android:layout_gravity="top|right" android:layout_marginEnd="12dp"
            android:layout_marginTop="16dp" android:visibility="gone">
            <TextView android:text="" android:layout_width="47dp" android:layout_height="47dp"
                android:layout_marginStart="66dp" android:layout_marginTop="7dp"
                android:background="@drawable/widget_aurora_sun"/>
            <TextView android:text="" android:layout_width="94dp" android:layout_height="39dp"
                android:layout_marginStart="6dp" android:layout_marginTop="29dp"
                android:background="@drawable/widget_aurora_cloud"/>
            <TextView android:text="" android:layout_width="46dp" android:layout_height="45dp"
                android:layout_marginStart="20dp" android:layout_marginTop="16dp"
                android:background="@drawable/widget_aurora_cloud"/>
            <TextView android:text="" android:layout_width="42dp" android:layout_height="40dp"
                android:layout_marginStart="53dp" android:layout_marginTop="21dp"
                android:background="@drawable/widget_aurora_cloud"/>
            <TextView android:text="" android:layout_width="8dp" android:layout_height="15dp"
                android:layout_marginStart="31dp" android:layout_marginTop="73dp"
                android:background="@drawable/widget_aurora_drop"/>
            <TextView android:text="" android:layout_width="8dp" android:layout_height="15dp"
                android:layout_marginStart="52dp" android:layout_marginTop="81dp"
                android:background="@drawable/widget_aurora_drop"/>
            <TextView android:text="" android:layout_width="8dp" android:layout_height="15dp"
                android:layout_marginStart="73dp" android:layout_marginTop="74dp"
                android:background="@drawable/widget_aurora_drop"/>
            <TextView android:text="" android:layout_width="8dp" android:layout_height="15dp"
                android:layout_marginStart="94dp" android:layout_marginTop="82dp"
                android:background="@drawable/widget_aurora_drop"/>
        </FrameLayout>
        <TextView android:id="@+id/widget_aurora_weather"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|right" android:layout_marginEnd="18dp"
            android:layout_marginBottom="18dp" android:text="Staffanstorp • —°"
            android:textSize="15sp" android:textColor="#FFF5E6CB"
            android:singleLine="true"/>
    </FrameLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="200dp"
        android:layout_marginStart="38dp" android:layout_marginEnd="25dp"
        android:layout_marginTop="314dp" android:background="@android:color/transparent"
        android:elevation="0dp">
        <FrameLayout android:layout_width="160dp" android:layout_height="160dp"
            android:layout_marginTop="36dp" android:layout_marginStart="11dp"
            android:background="@android:color/transparent">
            <ImageView android:id="@+id/widget_aurora_dynamic_ring"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" android:contentDescription="@null"
                android:clickable="false" android:focusable="false"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="center" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/widget_aurora_progress_pct"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0%" android:textSize="32sp" android:textColor="#FFFFFFFF"
                    android:fontFamily="sans-serif-light" android:includeFontPadding="false"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="KLAR" android:textSize="17sp"
                    android:textColor="#FFE4D7D7" android:includeFontPadding="false"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="110dp"
            android:layout_marginStart="160dp" android:layout_marginEnd="16dp"
            android:layout_marginTop="78dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="43dp"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="24dp" android:layout_height="24dp"
                    android:text="" android:textSize="21sp"
                    android:gravity="center" android:textColor="#FFF1E2DB"/>
                <TextView android:id="@+id/widget_aurora_event1"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:paddingStart="5dp"
                    android:text="Inga aktiviteter idag" android:textSize="12sp"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
                    android:textColor="#FFEEEAE9" android:singleLine="true"
                    android:ellipsize="end"/>
                <TextView android:layout_width="19dp" android:layout_height="wrap_content"
                    android:text="💡" android:textSize="14sp"/>
            </LinearLayout>
            <TextView android:text="" android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#6DFFFFFF"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="43dp"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="24dp" android:layout_height="24dp"
                    android:text="" android:textSize="21sp"
                    android:gravity="center" android:textColor="#FFF1E2DB"/>
                <TextView android:id="@+id/widget_aurora_event2"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:paddingStart="5dp"
                    android:text="" android:textSize="12sp"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
                    android:textColor="#FFEEEAE9" android:singleLine="true"
                    android:ellipsize="end"/>
                <TextView android:layout_width="19dp" android:layout_height="wrap_content"
                    android:text="🌲" android:textSize="14sp"/>
                <TextView android:id="@+id/widget_aurora_event2_more"
                    android:layout_width="21dp" android:layout_height="22dp"
                    android:gravity="center" android:text="×" android:textSize="17sp"
                    android:textColor="#BBFFFFFF"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout android:layout_width="41dp" android:layout_height="85dp"
        android:layout_marginTop="170dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/widget_aurora_tab">
        <TextView android:id="@+id/widget_aurora_battery"
            android:layout_width="85dp" android:layout_height="41dp"
            android:layout_gravity="center" android:gravity="center"
            android:rotation="-90" android:text="84% ⚡"
            android:textColor="#FFF2EAF1" android:textSize="15sp"
            android:singleLine="true" android:includeFontPadding="false"
            android:contentDescription="84% ⚡"/>
    </FrameLayout>
    <FrameLayout android:layout_width="41dp" android:layout_height="91dp"
        android:layout_marginTop="257dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/widget_aurora_tab">
        <TextView android:id="@+id/widget_todo"
            android:layout_width="91dp" android:layout_height="41dp"
            android:layout_gravity="center" android:gravity="center"
            android:rotation="-90" android:text="Att göra"
            android:textColor="#FFF2EAF1" android:textSize="15sp"
            android:singleLine="true" android:includeFontPadding="false"
            android:contentDescription="Att göra"/>
    </FrameLayout>
    <FrameLayout android:layout_width="41dp" android:layout_height="116dp"
        android:layout_marginTop="385dp"
        android:layout_marginStart="9dp"
        android:background="@drawable/widget_aurora_tab">
        <TextView android:id="@+id/widget_aurora_activity_tab"
            android:layout_width="116dp" android:layout_height="41dp"
            android:layout_gravity="center" android:gravity="center"
            android:rotation="-90" android:text="Aktivitet"
            android:textColor="#FFF2EAF1" android:textSize="15sp"
            android:singleLine="true" android:includeFontPadding="false"
            android:contentDescription="Aktivitet"/>
    </FrameLayout>
    <FrameLayout android:layout_width="41dp" android:layout_height="91dp"
        android:layout_marginTop="398dp"
        android:layout_gravity="top|right" android:layout_marginEnd="12dp"
        android:background="@drawable/widget_aurora_tab">
        <TextView android:id="@+id/widget_shopping"
            android:layout_width="91dp" android:layout_height="41dp"
            android:layout_gravity="center" android:gravity="center"
            android:rotation="-90" android:text="Inköp"
            android:textColor="#FFF2EAF1" android:textSize="15sp"
            android:singleLine="true" android:includeFontPadding="false"
            android:contentDescription="Inköp"/>
    </FrameLayout>
    <!-- These compatibility IDs keep existing sync and RemoteViews notifications safe. -->
    <TextView android:id="@+id/widget_status" android:layout_width="0dp"
        android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/widget_updated" android:layout_width="0dp"
        android:layout_height="0dp" android:visibility="gone"/>
    <ListView android:id="@+id/widget_event_list" android:layout_width="0dp"
        android:layout_height="0dp" android:visibility="gone"/>
</FrameLayout>