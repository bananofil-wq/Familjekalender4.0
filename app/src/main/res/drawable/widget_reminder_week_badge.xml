<?xml version="1.0" encoding="utf-8"?>
<!-- Small warm-metal glass week badge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#8A060C15"/><corners android:radius="12dp"/>
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#80627683"
                android:endColor="#8B26303D"/>
            <corners android:radius="12dp"/>
            <stroke android:width="0.8dp" android:color="#B1D0AC74"/>
            <padding android:left="9dp" android:top="3dp"
                android:right="9dp" android:bottom="3dp"/>
        </shape>
    </item>
    <item android:left="3dp" android:right="3dp" android:top="2dp"
        android:height="8dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4AFFF7E2"
                android:endColor="#00FFFFFF"/>
            <corners android:topLeftRadius="10dp" android:topRightRadius="10dp"/>
        </shape>
    </item>
</layer-list>