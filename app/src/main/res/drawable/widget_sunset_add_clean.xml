<?xml version="1.0" encoding="utf-8"?>
<!-- Compact freestanding gold-edged + button, no rectangular photographic residue. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#AD120E0B"/>
            <corners android:radius="15dp"/>
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#504440" android:centerColor="#36302D" android:endColor="#201C1B"/>
            <corners android:radius="15dp"/>
            <stroke android:width="1.5dp" android:color="#B8864C"/>
        </shape>
    </item>
</layer-list>
