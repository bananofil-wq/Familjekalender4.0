<?xml version="1.0" encoding="utf-8"?>
<!-- Lifted square, restrained light strip rather than mirror shine. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
 <item android:top="6dp"><shape android:shape="rectangle">
  <solid android:color="#CE030710"/><corners android:radius="12dp"/></shape></item>
 <item android:bottom="5dp"><shape android:shape="rectangle">
  <gradient android:angle="270" android:startColor="#EE46576C"
   android:centerColor="#F32A394B" android:endColor="#FE111D2C"/>
  <corners android:radius="12dp"/>
  <stroke android:width="1dp" android:color="#A99EB1C5"/>
 </shape></item>
 <item android:left="3dp" android:right="3dp" android:top="2dp"
   android:height="7dp" android:gravity="top">
  <shape android:shape="rectangle"><solid android:color="#27C9E2F9"/>
   <corners android:topLeftRadius="9dp" android:topRightRadius="9dp"/></shape>
 </item>
</layer-list>