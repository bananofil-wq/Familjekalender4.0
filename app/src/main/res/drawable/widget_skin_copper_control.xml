<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <!-- Polished copper controls with clear typography and no decorative overlay. -->
            <gradient android:angle="0"
                android:startColor="#F0754636"
                android:centerColor="#F29A5D42"
                android:endColor="#F16E3E30"/>
            <corners android:radius="22dp"/>
            <stroke android:width="1dp" android:color="#E9D5A783"/>
        </shape>
    </item>
</layer-list>
