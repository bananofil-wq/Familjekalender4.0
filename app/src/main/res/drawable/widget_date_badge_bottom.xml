<?xml version="1.0" encoding="utf-8"?>
<!-- Ceramic-silver date face with glass top and shaded bottom bevel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFFFFF"
                android:centerColor="#FFF0F3F8" android:endColor="#FFCBD3E0"/>
            <corners android:bottomLeftRadius="13dp" android:bottomRightRadius="13dp"/>
            <stroke android:width="0.8dp" android:color="#C6E9F1FF"/>
        </shape>
    </item>
    <item android:left="2dp" android:right="2dp" android:top="0dp"
        android:height="9dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#C4FFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>
    <item android:left="3dp" android:right="3dp" android:bottom="1dp"
        android:height="2dp" android:gravity="bottom">
        <shape android:shape="rectangle"><solid android:color="#558C9CAF"/>
            <corners android:bottomLeftRadius="10dp" android:bottomRightRadius="10dp"/>
        </shape>
    </item>
</layer-list>
