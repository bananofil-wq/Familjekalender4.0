<?xml version="1.0" encoding="utf-8"?>
<!-- Deep floating reminder panel, no mirror-like shine. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
 <item android:top="9dp">
  <shape android:shape="rectangle"><solid android:color="#E600040B"/><corners android:radius="24dp"/></shape>
 </item>
 <item android:left="2dp" android:right="2dp" android:top="5dp" android:bottom="2dp">
  <shape android:shape="rectangle"><solid android:color="#B309121D"/><corners android:radius="23dp"/></shape>
 </item>
 <item android:bottom="7dp">
  <shape android:shape="rectangle">
   <gradient android:angle="270" android:startColor="#FF374657"
    android:centerColor="#FF273241" android:endColor="#FF111A27"/>
   <corners android:radius="22dp"/>
   <stroke android:width="1dp" android:color="#A47E93A8"/>
  </shape>
 </item>
 <item android:left="4dp" android:right="4dp" android:top="2dp" android:height="12dp" android:gravity="top">
  <shape android:shape="rectangle">
   <gradient android:angle="270" android:startColor="#28C4D6EB" android:endColor="#00C4D6EB"/>
   <corners android:topLeftRadius="18dp" android:topRightRadius="18dp"/>
  </shape>
 </item>
</layer-list>