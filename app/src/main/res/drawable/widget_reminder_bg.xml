<?xml version="1.0" encoding="utf-8"?>
<!-- Nuvarande: glossy floating reminder panel, retained layout and click targets. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#BC000711"/>
            <corners android:radius="23dp"/>
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F4485667"
                android:centerColor="#F22A3544" android:endColor="#FB151D2A"/>
            <corners android:radius="22dp"/>
            <stroke android:width="1dp" android:color="#B5B1BCCB"/>
        </shape>
    </item>
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <corners android:radius="20dp"/>
            <stroke android:width="0.7dp" android:color="#497E91A8"/>
        </shape>
    </item>
    <item android:left="3dp" android:right="3dp" android:top="2dp"
        android:height="40dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4CA5BDD3"
                android:endColor="#005F7892"/>
            <corners android:topLeftRadius="19dp" android:topRightRadius="19dp"/>
        </shape>
    </item>
</layer-list>
