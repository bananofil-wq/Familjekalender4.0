<?xml version="1.0" encoding="utf-8"?>
<!-- Individual reminder pills cast shadows for separation, not glossy bands. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
 <item android:top="5dp"><shape android:shape="rectangle">
   <solid android:color="#C500040B"/><corners android:radius="13dp"/></shape></item>
 <item android:bottom="4dp"><shape android:shape="rectangle">
   <gradient android:angle="270" android:startColor="#FF394858"
    android:centerColor="#FF2B3746" android:endColor="#FF1A2432"/>
   <corners android:radius="12dp"/>
   <stroke android:width="0.8dp" android:color="#8B8498AB"/>
 </shape></item>
 <item android:left="2dp" android:right="2dp" android:top="2dp" android:height="6dp" android:gravity="top">
  <shape android:shape="rectangle"><solid android:color="#1CC1D7F0"/>
   <corners android:topLeftRadius="10dp" android:topRightRadius="10dp"/></shape>
 </item>
 <item android:gravity="left|center_vertical" android:left="5dp" android:bottom="2dp">
  <shape android:shape="rectangle">
   <size android:width="3dp" android:height="17dp"/>
   <gradient android:angle="270" android:startColor="#FFE3BC8B" android:endColor="#B0784B32"/>
   <corners android:radius="3dp"/>
  </shape>
 </item>
</layer-list>