<?xml version="1.0" encoding="utf-8"?>
<!-- Refined material: one quiet gradient and one hairline edge; no overlay textures. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#F8F1F5F7"
        android:endColor="#F6DDE5EB"/>
    <corners android:radius="30dp"/>
    <stroke android:width="0.8dp" android:color="#7F899BA8"/>
</shape>
