<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#55000000"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FAFFFFFF" android:centerColor="#F9F0E8FF" android:endColor="#F9F0E8FF"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1dp" android:color="#C3D5A7DC"/>
        </shape>
    </item>
    <item android:drawable="@drawable/widget_material_pastel" android:bottom="2dp"/>
</layer-list>
