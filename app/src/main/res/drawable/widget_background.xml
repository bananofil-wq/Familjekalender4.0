<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#96000000"/>
            <corners android:radius="29dp"/>
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315"
                android:startColor="#F21D222A"
                android:centerColor="#F5181C23"
                android:endColor="#F00C1017"/>
            <corners android:radius="29dp"/>
            <stroke android:width="1dp" android:color="#A2B0B8C4"/>
        </shape>
    </item>
    <item android:drawable="@drawable/widget_premium_texture" android:bottom="3dp"/>
</layer-list>