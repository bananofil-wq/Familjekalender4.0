<?xml version="1.0" encoding="utf-8"?>
<!-- Raised graphite metallic refresh disc. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape android:shape="oval"><solid android:color="#B700040A"/></shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#ED77889A"
                android:centerColor="#ED354252" android:endColor="#FB111A27"/>
            <stroke android:width="1dp" android:color="#D3B6C6D6"/>
        </shape>
    </item>
    <item android:left="3dp" android:right="3dp" android:top="2dp"
        android:height="17dp" android:gravity="top">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#68ECF5FF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>
</layer-list>
