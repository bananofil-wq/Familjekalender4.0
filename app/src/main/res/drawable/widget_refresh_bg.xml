<?xml version="1.0" encoding="utf-8"?>
<!-- Elevated dark-metal round button, subtle top edge, deeper shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
 <item android:top="6dp"><shape android:shape="oval"><solid android:color="#DB00060E"/></shape></item>
 <item android:bottom="5dp"><shape android:shape="oval">
  <gradient android:angle="270" android:startColor="#F14C5E72"
   android:centerColor="#F12A3B4D" android:endColor="#FF101B2A"/>
  <stroke android:width="1dp" android:color="#B19BAEBF"/>
 </shape></item>
 <item android:left="4dp" android:right="4dp" android:top="2dp"
  android:height="8dp" android:gravity="top">
  <shape android:shape="oval"><solid android:color="#25B7D3EB"/></shape>
 </item>
</layer-list>