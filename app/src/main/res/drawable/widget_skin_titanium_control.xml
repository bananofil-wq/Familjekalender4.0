    <gradient android:angle="270" android:startColor="#FFC8DCEC"
        android:endColor="#FFAAC8DE"/>
    <corners android:radius="22dp"/>
    <stroke android:width="0.8dp" android:color="#7F899BA8"/>
</shape>
