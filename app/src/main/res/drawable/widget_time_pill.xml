<?xml version="1.0" encoding="utf-8"?>
<!-- Small embossed graphite time capsule. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#7B020812"/><corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#C05E6C7D"
                android:centerColor="#A0424C5B" android:endColor="#B02B3442"/>
            <corners android:radius="18dp"/>
            <stroke android:width="0.85dp" android:color="#8297A9BE"/>
        </shape>
    </item>
    <item android:left="3dp" android:right="3dp" android:top="2dp"
        android:height="9dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#5AE6F2FF"
                android:endColor="#00E6F2FF"/>
            <corners android:topLeftRadius="17dp" android:topRightRadius="17dp"/>
        </shape>
    </item>
</layer-list>
