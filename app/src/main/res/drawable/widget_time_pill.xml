<?xml version="1.0" encoding="utf-8"?>
<!-- Recessed dark time capsule with real-looking lower shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
 <item android:top="4dp">
  <shape android:shape="rectangle"><solid android:color="#A700050E"/><corners android:radius="18dp"/></shape>
 </item>
 <item android:bottom="3dp">
  <shape android:shape="rectangle">
   <gradient android:angle="270" android:startColor="#B74C5B6C" android:endColor="#D01D2838"/>
   <corners android:radius="18dp"/>
   <stroke android:width="0.8dp" android:color="#7691A5BB"/>
  </shape>
 </item>
 <item android:left="3dp" android:right="3dp" android:top="2dp" android:height="5dp" android:gravity="top">
  <shape android:shape="rectangle"><solid android:color="#1EBAD2EB"/>
   <corners android:topLeftRadius="15dp" android:topRightRadius="15dp"/></shape>
 </item>
</layer-list>