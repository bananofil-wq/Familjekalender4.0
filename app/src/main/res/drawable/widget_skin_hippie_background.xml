    <gradient android:angle="270" android:startColor="#FAFFF6EE"
        android:endColor="#F9F3E5F1"/>
    <corners android:radius="30dp"/>
    <stroke android:width="0.8dp" android:color="#82B28DA0"/>
</shape>
