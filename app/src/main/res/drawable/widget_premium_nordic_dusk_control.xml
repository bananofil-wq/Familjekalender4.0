<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gentle edge and a one-pixel inset emulate tactile depth without gloss. -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#32000000"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#EE577285"
                android:endColor="#F33B556A"/>
            <corners android:radius="20dp"/>
            <stroke android:width="0.7dp" android:color="#9A808FA0"/>
        </shape>
    </item>
</layer-list>
