<?xml version="1.0" encoding="utf-8"?>
<!-- Raised emerald: thick drop shadow, restrained gleam. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
 <item android:top="7dp"><shape android:shape="rectangle">
  <solid android:color="#DC00140E"/><corners android:radius="25dp"/></shape></item>
 <item android:left="1dp" android:right="1dp" android:top="4dp" android:bottom="2dp">
  <shape android:shape="rectangle"><solid android:color="#B50B493B"/><corners android:radius="24dp"/></shape></item>
 <item android:bottom="6dp">
  <shape android:shape="rectangle">
   <gradient android:angle="270" android:startColor="#F1205E4F"
    android:centerColor="#F111453A" android:endColor="#FF092C27"/>
   <corners android:radius="24dp"/>
   <stroke android:width="1.2dp" android:color="#E046BA92"/>
  </shape>
 </item>
 <item android:left="4dp" android:right="4dp" android:top="2dp" android:height="8dp" android:gravity="top">
  <shape android:shape="rectangle">
   <gradient android:angle="270" android:startColor="#30C7F8E4" android:endColor="#00C7F8E4"/>
   <corners android:topLeftRadius="21dp" android:topRightRadius="21dp"/>
  </shape>
 </item>
</layer-list>