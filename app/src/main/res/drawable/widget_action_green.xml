<?xml version="1.0" encoding="utf-8"?>
<!-- Embossed emerald shortcut: saturated edge, curved glass reflection. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#B400100E"/><corners android:radius="25dp"/>
        </shape>
    </item>
    <item android:top="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F02B7766"
                android:centerColor="#EF174339" android:endColor="#FB0D2627"/>
            <corners android:radius="25dp"/>
            <stroke android:width="1.3dp" android:color="#E46EE2B1"/>
        </shape>
    </item>
    <item android:left="3dp" android:right="3dp" android:top="2dp"
        android:height="18dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#70DDFEEE"
                android:endColor="#00D6FFEB"/>
            <corners android:topLeftRadius="23dp" android:topRightRadius="23dp"/>
        </shape>
    </item>
    <item android:left="8dp" android:right="8dp" android:bottom="4dp"
        android:height="1dp" android:gravity="bottom">
        <shape android:shape="rectangle"><solid android:color="#4DA5FAD3"/></shape>
    </item>
</layer-list>
