<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#38000000"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#E1553725"
                android:centerColor="#DC3A251B"
                android:endColor="#DF281B16"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1dp" android:color="#B8C79B70"/>
        </shape>
    </item>
    <item android:drawable="@drawable/widget_wood_approved_row_grain" android:bottom="1dp"/>
</layer-list>
